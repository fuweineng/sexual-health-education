---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '性健康科普',
  description = '把复杂的性健康知识讲清楚：同意、避孕、检测与身体常识。',
} = Astro.props;
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/topics/consent-boundaries/', label: '同意与边界' },
  { href: '/topics/contraception/', label: '避孕' },
  { href: '/topics/sti-prevention/', label: '感染与检测' },
  { href: '/sources/', label: '来源说明' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}｜性健康科普</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="性健康科普首页">
          <span class="brand-mark" aria-hidden="true">✦</span>
          <span>
            <strong>性健康科普</strong>
            <small>把知识讲清楚</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>性健康科普</strong>
          <p>独立编写的一般科普内容，不替代医生诊断或个体化治疗建议。</p>
        </div>
        <div class="footer-links">
          <a href="/about/">关于本站</a>
          <a href="/sources/">来源与版权</a>
        </div>
      </div>
    </footer>
  </body>
</html>
