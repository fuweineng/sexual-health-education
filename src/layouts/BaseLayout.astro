---
import '../styles/global.css';
import { mainLinks, siteLinks } from '../data/nav';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '性健康科普',
  description = '把复杂的性健康知识讲清楚：同意、避孕、检测与身体常识。',
} = Astro.props;
const currentPath = Astro.url.pathname;

const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}｜性健康科普</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="性健康科普首页">
          <span class="brand-mark" aria-hidden="true">✦</span>
          <span>
            <strong>性健康科普</strong>
            <small>把知识讲清楚</small>
          </span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
        <label for="nav-toggle" class="nav-toggle-label" aria-hidden="true">
          <span></span><span></span><span></span>
        </label>

        <nav class="site-nav" aria-label="主导航">
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>首页</a>

          <details class="nav-drop" open={false}>
            <summary class={isActive('/main/') ? 'is-active' : undefined}>正文</summary>
            <div class="nav-panel">
              {mainLinks.map((link) => (
                <div class="nav-panel-group">
                  <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
                  {link.children && (
                    <div class="nav-panel-children">
                      {link.children.map((child) => (
                        <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>{child.label}</a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </details>

          <a href="/article/" aria-current={isActive('/article/') ? 'page' : undefined}>文章</a>
          <a href="/dict/" aria-current={isActive('/dict/') ? 'page' : undefined}>词典</a>

          <a href="/general/copyright/" aria-current={isActive('/general/') ? 'page' : undefined}>版权许可</a>

          <a href="/sitemap/" aria-current={isActive('/sitemap/') ? 'page' : undefined}>站点地图</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>性健康科普</strong>
          <p>独立编写的一般科普内容，不替代医生诊断或个体化治疗建议。本站为非商业信息项目，不接受捐赠、不设付费内容。</p>
        </div>
        <div class="footer-links">
          {siteLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href="/sitemap/">站点地图</a>
        </div>
      </div>
    </footer>
  </body>
</html>
