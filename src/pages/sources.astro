---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoNote from '../components/InfoNote.astro';
import { articles } from '../data/articles';
import { credits } from '../data/credits';
---

<BaseLayout title="来源与图示说明" description="本站的参考资料、图片来源、许可条款与署名信息。">
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Sources and rights</p>
      <h1>每一条结论，都应该能回到来源。</h1>
      <p>本站尽量使用权威、公开、适合普通读者理解的资料。参考资料名称会随文章一起列出，读者可以据此查找更完整的信息。</p>
    </header>
  </div>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Reference groups</p>
          <h2>主要参考方向</h2>
        </div>
        <p>资料用于核对事实与方向，不代表任何机构对本站的背书。</p>
      </div>
      <ul class="policy-list">
        <li><strong>世界卫生组织（WHO）</strong>用于性健康、避孕、性别暴力与青少年健康等主题的公开资料。</li>
        <li><strong>联合国相关机构</strong>用于权利、同意、性教育与生殖健康背景资料的交叉核对。</li>
        <li><strong>各国公共卫生与医疗体系</strong>包括疾病预防控制机构和国民保健服务体系发布的公众教育材料。</li>
        <li><strong>专业医学组织</strong>用于妇产科、儿科、心理健康等主题的术语解释与就医提示。</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Illustrations</p>
          <h2>图片来源与授权</h2>
        </div>
        <p>站内照片与图表来自 Wikimedia Commons，只选用公有领域、CC0 或 CC BY / CC BY-SA 许可的素材。</p>
      </div>

      <InfoNote label="许可筛选原则">
        只使用允许非商业使用、再分发并要求署名的许可；不使用带 NC / ND 限制的素材，也不复制其他站点的图片文件。每张图都会列出作者、许可条款和原始文件页，读者可自行核对。
      </InfoNote>

      <div class="table-wrap">
        <table class="credit-table">
          <caption>图片授权清单</caption>
          <thead>
            <tr>
              <th scope="col">文件</th>
              <th scope="col">使用页面</th>
              <th scope="col">作者</th>
              <th scope="col">许可</th>
              <th scope="col">来源</th>
            </tr>
          </thead>
          <tbody>
            {credits.map((credit) => (
              <tr>
                <td><code>{credit.file}</code></td>
                <td>{credit.pages.join('、')}</td>
                <td>{credit.artist}</td>
                <td>
                  {credit.licenseUrl ? (
                    <a href={credit.licenseUrl} target="_blank" rel="noopener noreferrer">{credit.license}</a>
                  ) : (
                    credit.license
                  )}
                </td>
                <td>
                  <a href={credit.source} target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="note">
        图片按原样使用并按容器缩放显示，未改动画面上的文字与构图。CC BY-SA 材料随附其许可条款链接，复制或改编这些素材时需遵循相同许可要求。许可状态可能随原作者调整，发现问题请以原始文件页的最新说明为准。
      </p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Byline</p>
          <h2>文章署名与更新时间</h2>
        </div>
        <p>文字内容由本站独立编写，引用来源仅用于核对事实，不构成合作或背书关系。</p>
      </div>
      <ul class="policy-list">
        {articles.map((article) => (
          <li><strong>{article.title}</strong>更新于 {article.updated}，约 {article.readTime}。</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InfoNote label="版权边界">
        <p>本站文章、页面结构与代码均为独立编写，不转载其他站点的文字，也不复制其排版。图片按上表逐项标注作者与许可，发现署名错误或许可状态变化，请通过本站公开联系方式说明具体情况。</p>
      </InfoNote>
    </div>
  </section>
</BaseLayout>
