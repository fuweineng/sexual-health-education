---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoNote from '../components/InfoNote.astro';
import TopicCard from '../components/TopicCard.astro';
import Figure from '../components/Figure.astro';
import { topics } from '../data/topics';
import { articles } from '../data/articles';
import { credits } from '../data/credits';

const totalMinutes = articles.reduce((sum, article) => sum + Number.parseInt(article.readTime, 10), 0);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Independent sex education</p>
      <h1>把复杂的性健康知识，<em>讲清楚</em>。</h1>
      <p class="lede">
        一个独立编写的中文科普站，聊聊同意、避孕、检测、身体和数字生活。我们相信，好的信息应该让人更安心，而不是更焦虑。
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#topics">从基础话题开始</a>
        <a class="button button-secondary" href="/article/common-myths/">先看常见误区</a>
      </div>
      <dl class="hero-stats">
        <div>
          <dt>{articles.length}</dt>
          <dd>篇原创长文</dd>
        </div>
        <div>
          <dt>{topics.length}</dt>
          <dd>个主题入口</dd>
        </div>
        <div>
          <dt>{totalMinutes}</dt>
          <dd>分钟阅读量</dd>
        </div>
        <div>
          <dt>{credits.length}</dt>
          <dd>张图片逐项署名</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" id="topics">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2>先从最常见的问题开始</h2>
        </div>
        <p>每篇文章都尽量使用清楚的语言，配开放许可的图片并逐项署名，在文末列出参考来源。健康情况因人而异，必要时请咨询专业人员。</p>
      </div>
      <div class="topics-grid">
        {topics.map((topic) => <TopicCard topic={topic} />)}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Deep dive</p>
          <h2>用图片理解，而不是死记名词</h2>
        </div>
        <p>照片与图表均来自公有领域或开放许可素材，署名与许可条款见图注和<a href="/general/copyright/">版权许可</a>。</p>
      </div>
      <div class="figure-grid">
        <Figure
          figure={{
            src: '/images/real/cycle-hormone-zh.png',
            alt: '月经周期中雌激素水平变化的中文图表',
            caption: '月经周期：激素随阶段变化，不用于预测个人排卵时间。',
          }}
        />
        <Figure
          figure={{
            src: '/images/real/contraception-pills.jpg',
            alt: '口服避孕药铝箔板照片',
            caption: '避孕方法：按需求选择，而不是按流行度选择。',
          }}
        />
        <Figure
          figure={{
            src: '/images/real/sti-hiv-kit.jpg',
            alt: 'HIV 抗体检测试剂盒照片',
            caption: '检测工具：重点在于检测时机与复测安排。',
          }}
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Reference</p>
          <h2>两个查问题的入口</h2>
        </div>
        <p>遇到具体说法或名词时，可以先查<a href="/article/common-myths/">常见误区</a>和<a href="/dict/">术语表</a>。</p>
      </div>
      <div class="reference-grid">
        <a class="reference-card" href="/article/common-myths/">
          <h3>二十个常见误区</h3>
          <p>从“第一次不会怀孕”到紧急避孕的误解，附带更准确的理解。</p>
        </a>
        <a class="reference-card" href="/dict/">
          <h3>性健康术语表</h3>
          <p>用中性、简洁的语言解释同意、边界、窗口期等常见术语。</p>
        </a>
        <a class="reference-card" href="/general/copyright/">
          <h3>版权许可与图片来源</h3>
          <p>文字许可条件、图片授权清单、署名与更新时间。</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How we write</p>
          <h2>我们怎样整理内容</h2>
        </div>
        <p>科普不是口号，更不是诊断书。我们把证据、边界和不确定性一起写出来。</p>
      </div>
      <div class="principles">
        <div class="principle">
          <span class="principle-number">01 / CLEAR</span>
          <h3>先说人话</h3>
          <p>尽量解释术语背后的原因，而不是堆叠名词。读完之后，你应该知道下一步可以问什么。</p>
        </div>
        <div class="principle">
          <span class="principle-number">02 / HONEST</span>
          <h3>承认不确定</h3>
          <p>人体没有标准答案，方法也有适用边界。我们不会把个别经验包装成适用于所有人的规则。</p>
        </div>
        <div class="principle">
          <span class="principle-number">03 / KIND</span>
          <h3>不制造羞耻</h3>
          <p>好奇、犹豫和提问都很正常。站点不评判读者，也不把健康问题变成道德评价。</p>
        </div>
        <div class="principle">
          <span class="principle-number">04 / SOURCED</span>
          <h3>图片标注来源</h3>
          <p>照片与图表只选用公有领域或开放许可素材，作者、许可和原始文件页全部公开可查。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InfoNote label="阅读前请记住">
        <p>这里的内容用于一般科普，不能替代面对面问诊、检验或治疗。如果出现急性疼痛、异常出血、发热、持续不适或可能暴露于感染风险，请及时联系当地医疗机构。</p>
      </InfoNote>
    </div>
  </section>
</BaseLayout>
