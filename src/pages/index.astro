---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicBanner from '../components/TopicBanner.astro';
import { topics } from '../data/topics';

const cards = [
  ...topics.map((topic) => ({
    href: topic.href,
    title: topic.title,
    enTitle: topic.enTitle,
    figure: topic.figure,
  })),
  {
    href: '/article/',
    title: '文章',
    enTitle: 'Articles',
    figure: '/images/real/myths-library.avif',
  },
];
---

<BaseLayout>
  <div class="container index-main">
    <div class="banner-list">
      {cards.map((card, index) => <TopicBanner {...card} priority={index === 0} />)}
    </div>

    <h1 class="index-title">性健康科普：一份独立编写的中文性教育读物</h1>
    <p>
      性贯穿生命始终，每个人都应该获得清楚、可靠、不制造焦虑的性健康知识。本站依据若干分类独立编写一般性科普内容，涵盖身体结构、青春期、月经、性行为与同意、性生理、性取向、避孕与性传播疾病等主题，并尽量在文末列出可核对的资料来源。
    </p>
    <p>
      所有文字均为原创，图片只使用公有领域或开放许可素材并逐项署名，清单见<a href="/general/copyright/">版权许可</a>。内容用于一般健康教育，不能替代医生面对面的判断；遇到具体症状、用药或检测问题，请咨询具备资质的医务人员。
    </p>
  </div>
</BaseLayout>
