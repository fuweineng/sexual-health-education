---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoNote from '../components/InfoNote.astro';
import { mainLinks, siteLinks } from '../data/nav';
import { articles } from '../data/articles';

const mainEntries = mainLinks.map((link) => ({
  title: link.label,
  href: link.href,
  children: link.children ?? [],
}));

const articleEntries = [
  { title: '文章索引', href: '/article/' },
  ...articles
    .filter((article) => article.group === 'article')
    .map((article) => ({ title: article.title, href: `/article/${article.slug}/` })),
  { title: '二十个常见误区', href: '/article/common-myths/' },
];

const otherEntries = [
  { title: '词典（性健康术语表）', href: '/dict/' },
  ...siteLinks,
  { title: '隐私政策', href: '/general/privacy-policy/' },
  { title: '使用条款', href: '/general/terms-of-use/' },
];
---

<BaseLayout title="站点地图" description="本站全部页面的索引。">
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Sitemap</p>
      <h1>站点地图</h1>
      <p>全部页面按内容分组列出，方便查找与交叉阅读。</p>
    </header>
  </div>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Main</p>
          <h2>正文</h2>
        </div>
        <p>系统性入门内容，建议按顺序阅读。</p>
      </div>
      <div class="sitemap-grid">
        {mainEntries.map((entry) => (
          <div class="sitemap-group">
            <a class="sitemap-title" href={entry.href}>{entry.title}</a>
            {entry.children.length > 0 && (
              <div class="sitemap-children">
                {entry.children.map((child) => <a href={child.href}>{child.label}</a>)}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Articles</p>
          <h2>文章与清单</h2>
        </div>
        <p>针对单点问题的说明。</p>
      </div>
      <ul class="sitemap-list">
        {articleEntries.map((entry) => <li><a href={entry.href}>{entry.title}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Site</p>
          <h2>词典与站务</h2>
        </div>
        <p>术语解释、版权与联系方式。</p>
      </div>
      <ul class="sitemap-list">
        {otherEntries.map((entry) => <li><a href={entry.href}>{entry.title}</a></li>)}
      </ul>

      <InfoNote label="不含付费与捐赠内容">
        本站不设付费墙、不接受捐赠、不投放广告，因此不存在与交易或资助相关的页面。
      </InfoNote>
    </div>
  </section>
</BaseLayout>

<style>
  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
  }

  .sitemap-group {
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }

  .sitemap-title {
    display: block;
    font-weight: 650;
    color: var(--ink);
    text-decoration: none;
  }

  .sitemap-title:hover {
    text-decoration: underline;
  }

  .sitemap-children {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .sitemap-children a {
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-strong);
    color: var(--muted);
    font-size: 12px;
    text-decoration: none;
  }

  .sitemap-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 8px 24px;
    list-style: none;
  }

  .sitemap-list a {
    display: block;
    padding: 8px 0;
    border-bottom: 1px dashed var(--line);
  }
</style>
