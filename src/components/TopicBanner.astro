---
interface Props {
  href: string;
  title: string;
  enTitle?: string;
  figure?: string;
  priority?: boolean;
}

const { href, title, enTitle, figure, priority = false } = Astro.props;
---

<a class="banner" href={href}>
  {figure && (
    <img
      class="banner-image"
      src={figure}
      alt=""
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  )}
  <span class="banner-cover" aria-hidden="true"></span>
  <span class="banner-title">
    <span class="banner-title-cn">{title}</span>
    {enTitle && <span class="banner-title-en">{enTitle}</span>}
  </span>
</a>
